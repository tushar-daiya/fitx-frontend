{
  "expo": {
    "name": "FitX - Your AI Health Companion",
    "slug": "fitx",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fitx",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#D4AF37",
    "description": "AI personal trainer & nutritionist. Personalized workout + diet plans, meal scanner, fitness coach.",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/icon-ios.png",
      "version": "3.0.0",
      "bundleIdentifier": "com.fitx.health.app",
      "buildNumber": "9",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleDisplayName": "FitX",
        "NSCameraUsageDescription": "Scan meals to log calories instantly",
        "NSPhotoLibraryUsageDescription": "Pick a meal photo to analyse with AI",
        "NSPhotoLibraryAddUsageDescription": "Save workout progress photos",
        "NSMicrophoneUsageDescription": "Record workout videos for AI form check",
        "NSLocationWhenInUseUsageDescription": "Find gyms near you on the FitX Coach",
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": []
    },
    "android": {
      "version": "3.0.0",
      "package": "com.fitx.health",
      "versionCode": 20,
      "softwareKeyboardLayoutMode": "pan",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0D0D0D"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.health.READ_STEPS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/analytics",
      [
        "react-native-fbsdk-next",
        {
          "appID": "1538292474426570",
          "clientToken": "6964b866151cda914a34b0c240f83600",
          "displayName": "FitX",
          "scheme": "fb1538292474426570",
          "advertiserIDCollectionEnabled": true,
          "autoLogAppEventsEnabled": true,
          "isAutoInitEnabled": true
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "enableSceneSupport": true
          },
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "FitX uses your motion data to count your daily steps."
        }
      ],
      "react-native-health-connect",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification_icon.png",
          "color": "#D4AF37"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0D0D",
          "imageWidth": 200
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "FitX needs access to your photos to scan meals.",
          "cameraPermission": "FitX needs camera access to scan meals."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Find gyms near you on the FitX Coach."
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-speech-recognition",
      "expo-video",
      "expo-image",
      "expo-status-bar",
      "./plugins/withAndroidReleaseSigning",
      "./plugins/withAppLabel"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8ca85568-8d0e-4a77-a3f3-2347927e47ec"
      }
    },
    "owner": "tushar-daiya"
  }
}
